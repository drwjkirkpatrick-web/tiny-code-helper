#!/usr/bin/env bash
# code-llm: start/stop/status helper for llama.cpp + Gemma 4 E2B with MTP
# Optimized for code generation on Jetson (42.7 tok/s benchmark).
# Usage: code-llm start | stop | status | test | log

set -euo pipefail

LLAMA_BIN="$HOME/llama.cpp/build/bin/llama-server"
MODEL="$HOME/models/gemma-4-E2B-it-Q4_K_M.gguf"
MTP_MODEL="$HOME/models/gemma-4-e2b-mtp/mtp-gemma-4-E2B-it.gguf"
PIDFILE="/tmp/code-llm.pid"
NANNY_PIDFILE="/tmp/code-llm-nanny-bridge.pid"
NANNY_SCRIPT="$HOME/projects/tiny-code-helper/scripts/nanny_bridge.py"
NANNY_PROJECT="$HOME/projects/baby-llm-nanny"
BRIDGE_PORT=11435
PORT=8080
HOST=127.0.0.1

start() {
    if is_running; then
        echo "Already running (PID $(cat "$PIDFILE"))"
        return 0
    fi

    echo "Starting llama.cpp server (Gemma 4 E2B + MTP)..."

    # Free GPU memory if Ollama is running
    if pgrep -f "ollama serve" >/dev/null 2>&1; then
        echo "  Stopping Ollama to free GPU/RAM..."
        pkill -f "ollama serve"
        sleep 2
    fi

    # Max clock speeds
    sudo jetson_clocks 2>/dev/null || true

    # Launch in background
    "$LLAMA_BIN" \
        -m "$MODEL" \
        -md "$MTP_MODEL" \
        -ngl 99 -ngld 99 \
        --spec-type draft-mtp --spec-draft-n-max 4 \
        -c "${CTX:-4096}" -t 6 \
        --temp 1.0 --top-p 0.95 --top-k 64 \
        --host "$HOST" --port "$PORT" \
        > /tmp/code-llm.log 2>&1 &

    local pid=$!
    echo "$pid" > "$PIDFILE"
    echo "  PID: $pid"

    # Wait for server to be ready (up to 30s)
    echo -n "  Waiting for server..."
    for i in $(seq 1 15); do
        if curl -s "http://$HOST:$PORT/health" | grep -q "ok" 2>/dev/null; then
            echo " ready!"
            echo "  Endpoint: http://$HOST:$PORT/v1/chat/completions"
            echo ""
            echo "  Example:"
            echo "    curl -s http://$HOST:$PORT/v1/chat/completions \\"
            echo "      -H 'Content-Type: application/json' \\"
            echo "      -d '{\"messages\":[{\"role\":\"user\",\"content\":\"hello\"}]}'"
            return 0
        fi
        echo -n "."
        sleep 2
    done

    echo " FAILED (check /tmp/code-llm.log)"
    rm -f "$PIDFILE"
    return 1
}

stop() {
    if ! is_running; then
        echo "Not running."
        rm -f "$PIDFILE"
        return 0
    fi

    local pid=$(cat "$PIDFILE")
    echo "Stopping llama.cpp server (PID $pid)..."
    kill "$pid" 2>/dev/null || true
    sleep 1
    if kill -0 "$pid" 2>/dev/null; then
        kill -9 "$pid" 2>/dev/null || true
    fi
    rm -f "$PIDFILE"
    echo "Stopped."
}

status() {
    if is_running; then
        local pid=$(cat "$PIDFILE")
        local rss=$(ps -o rss= -p "$pid" 2>/dev/null | awk '{printf "%.0f MB", $1/1024}')
        echo "RUNNING  PID=$pid  RSS=$rss"
        echo "  Endpoint: http://$HOST:$PORT/v1/chat/completions"
        echo "  Log: /tmp/code-llm.log"
    else
        echo "STOPPED"
    fi
}

test_model() {
    if ! is_running; then
        echo "Server not running. Start it first: code-llm start"
        return 1
    fi
    echo "Testing code generation..."
    local start=$(date +%s%N)
    local resp
    resp=$(curl -s "http://$HOST:$PORT/v1/chat/completions" \
        -H "Content-Type: application/json" \
        -d '{
            "messages": [{"role":"user","content":"Write a Python function to reverse a linked list. Include Node class. Be concise."}],
            "max_tokens": 800,
            "temperature": 1.0,
            "top_p": 0.95
        }')
    local end=$(date +%s%N)
    local elapsed=$(( (end - start) / 1000000 ))

    # Gemma 4 E2B is a thinking model: reasoning_content first, then content
    echo "$resp" | python3 -c "
import sys, json
r = json.load(sys.stdin)
c = r['choices'][0]
msg = c['message']
content = msg.get('content','')
reasoning = msg.get('reasoning_content','')
u = r.get('usage',{})
tokens = u.get('completion_tokens','?')

if reasoning:
    print(f'[thinking: {len(reasoning)} chars]')
    print()
print(content)
print()
print('--- STATS ---')
print(f'  Total tokens: {tokens}')
" 2>/dev/null

    local tokens=$(echo "$resp" | python3 -c "import sys,json; print(json.load(sys.stdin).get('usage',{}).get('completion_tokens',0))" 2>/dev/null)
    echo "  Wall time: ${elapsed}ms"
    if [ "$tokens" != "?" ] && [ "$tokens" -gt 0 ] && [ "$elapsed" -gt 0 ]; then
        local tps=$(python3 -c "print(f'{$tokens / $elapsed * 1000:.1f}')")
        echo "  Est tok/s: $tps (includes thinking tokens)"
    fi
}

chat() {
    if ! is_running; then
        echo "Server not running. Start it first: code-llm start"
        return 1
    fi
    echo "Interactive chat with Gemma 4 E2B (thinking model). Type 'exit' to quit."
    echo "Add --think to see reasoning. Context resets each message.\n"

    local show_think=false
    local sys_msg="You are a helpful coding assistant. Be concise and correct."
    local max_tok=800

    # Parse simple flags
    while [[ "${1:-}" == -* ]]; do
        case "$1" in
            --think) show_think=true; shift ;;
            --tokens) max_tok="$2"; shift 2 ;;
            *) shift ;;
        esac
    done

    local history="[]"
    while true; do
        echo -n "> "
        read -r -e user_input
        [ -z "$user_input" ] && continue
        [ "$user_input" == "exit" ] || [ "$user_input" == "quit" ] && break

        # Build messages with system prompt
        local messages="[{\"role\":\"system\",\"content\":\"$sys_msg\"},"
        messages+="{\"role\":\"user\",\"content\":\"$(echo "$user_input" | sed 's/"/\\"/g; s/\n/\\n/g')\"}]"

        local resp
        resp=$(curl -s "http://$HOST:$PORT/v1/chat/completions" \
            -H "Content-Type: application/json" \
            -d "{\"messages\":$messages,\"max_tokens\":$max_tok,\"temperature\":1.0,\"top_p\":0.95}")

        echo "$resp" | python3 -c "
import sys, json
r = json.load(sys.stdin)
msg = r['choices'][0]['message']
show = ${show_think}
rc = msg.get('reasoning_content','')
if rc and show:
    print('[THINKING]')
    print(rc)
    print()
content = msg.get('content','')
if content:
    print(content)
else:
    print('[no content - try more max_tokens]')
" 2>/dev/null
        echo ""
    done
}

log() {
    if [ -f /tmp/code-llm.log ]; then
        tail -50 /tmp/code-llm.log
    else
        echo "No log file found."
    fi
}

# ── Nanny (baby-llm-nanny) integration ──────────────────────────

nanny_is_running() {
    [ -f "$NANNY_PIDFILE" ] && kill -0 "$(cat "$NANNY_PIDFILE")" 2>/dev/null
}

nanny_status() {
    if nanny_is_running; then
        local pid=$(cat "$NANNY_PIDFILE")
        echo "NANNY BRIDGE RUNNING  PID=$pid"
        echo "  Ollama API: http://127.0.0.1:$BRIDGE_PORT"
        echo "  -> llama.cpp: http://$HOST:$PORT"
    else
        echo "NANNY BRIDGE STOPPED"
    fi
}

nanny_start() {
    if ! is_running; then
        echo "llama.cpp server not running. Start it first: code-llm start"
        return 1
    fi
    if nanny_is_running; then
        echo "Nanny bridge already running (PID $(cat "$NANNY_PIDFILE"))"
        return 0
    fi
    if [ ! -f "$NANNY_SCRIPT" ]; then
        echo "Bridge script not found at $NANNY_SCRIPT"
        return 1
    fi

    echo "Starting nanny bridge (Ollama API -> llama.cpp)..."

    local review_flag=""
    if [ "${NANNY_REVIEW:-true}" = "true" ]; then
        review_flag="--review --max-fix-attempts ${NANNY_MAX_FIX:-3}"
        echo "  Real-time code review: ENABLED"
    fi

    python3 "$NANNY_SCRIPT" \
        --llama-port "$PORT" \
        --bridge-port "$BRIDGE_PORT" \
        $review_flag \
        > /tmp/code-llm-nanny-bridge.log 2>&1 &

    local pid=$!
    echo "$pid" > "$NANNY_PIDFILE"

    sleep 1
    if nanny_is_running; then
        echo "  PID: $pid"
        echo "  Ollama API: http://127.0.0.1:$BRIDGE_PORT"
        echo "  Model name: gemma-4-e2b"
        echo ""
        echo "  Run nanny from its project dir:"
        echo "    cd $NANNY_PROJECT"
        echo "    python3 -m baby_llm_nanny.cli gemma-4-e2b --host localhost --port $BRIDGE_PORT --review"
    else
        echo "  FAILED (check /tmp/code-llm-nanny-bridge.log)"
        rm -f "$NANNY_PIDFILE"
        return 1
    fi
}

nanny_stop() {
    if ! nanny_is_running; then
        echo "Nanny bridge not running."
        rm -f "$NANNY_PIDFILE"
        return 0
    fi
    local pid=$(cat "$NANNY_PIDFILE")
    echo "Stopping nanny bridge (PID $pid)..."
    kill "$pid" 2>/dev/null || true
    sleep 1
    rm -f "$NANNY_PIDFILE"
    echo "Stopped."
}

nanny_run() {
    # Run baby-llm-nanny against the llama.cpp server via the bridge
    if ! is_running; then
        echo "llama.cpp server not running. Start it first: code-llm start"
        return 1
    fi
    if ! nanny_is_running; then
        nanny_start || return 1
    fi

    local nanny_args=("${@:-}")
    if [ ${#nanny_args[@]} -eq 0 ]; then
        nanny_args=(--review --max-iterations 3)
    fi

    echo "Running baby-llm-nanny: gemma-4-e2b ${nanny_args[*]}"
    echo ""
    cd "$NANNY_PROJECT"
    python3 -m baby_llm_nanny.cli gemma-4-e2b \
        --host localhost --port "$BRIDGE_PORT" \
        "${nanny_args[@]}"
}

is_running() {
    [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

case "${1:-}" in
    start)  start ;;
    stop)   stop; nanny_stop ;;
    status) status; echo ""; nanny_status ;;
    test)   test_model ;;
    chat)   chat "${@:2}" ;;
    log)    log ;;
    restart) stop; nanny_stop; sleep 1; start ;;
    # Nanny commands
    nanny-start)  nanny_start ;;
    nanny-stop)   nanny_stop ;;
    nanny-status) nanny_status ;;
    nanny-run)   nanny_run "${@:2}" ;;
    nanny)       nanny_run "${@:2}" ;;
    *)
        echo "Usage: code-llm {start|stop|restart|status|test|chat|log}"
        echo "       code-llm {nanny|nanny-start|nanny-stop|nanny-status|nanny-run}"
        echo ""
        echo "  LLM server:"
        echo "    start   - Launch llama.cpp + Gemma 4 E2B with MTP (code-optimized)"
        echo "    stop    - Stop the server (also stops nanny bridge)"
        echo "    restart - Stop then start"
        echo "    status  - Show running state and memory usage"
        echo "    test    - Run a code-gen test and show throughput"
        echo "    chat    - Interactive coding chat (--think to see reasoning, --tokens N)"
        echo "    log     - Tail the last 50 log lines"
        echo ""
        echo "  Baby LLM Nanny (hallucination screening):"
        echo "    nanny           - Auto-start bridge + run nanny --review (default)"
        echo "    nanny-start     - Start the Ollama-to-llama.cpp bridge"
        echo "    nanny-stop      - Stop the bridge"
        echo "    nanny-status    - Show bridge state"
        echo "    nanny-run ARGS  - Run nanny with custom args (passes ARGS to baby-llm-nanny)"
        echo ""
        echo "Env overrides:"
        echo "  CTX=8192 code-llm start         - Use larger context window (default 4096)"
        echo "  NANNY_REVIEW=false code-llm nanny  - Disable real-time code review in bridge"
        echo "  NANNY_MAX_FIX=5 code-llm nanny      - Max auto-fix retries (default 3)"
        echo "  BRIDGE_PORT=11440 code-llm nanny    - Use different bridge port"
        exit 1
        ;;
esac